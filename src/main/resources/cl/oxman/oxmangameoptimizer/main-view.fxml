<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cl.oxman.oxmangameoptimizer.ui.MainController"
      fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="main-scroll">
  <content>
  <VBox alignment="TOP_CENTER" spacing="7" maxWidth="Infinity" styleClass="oxman-content">

    <padding>
        <Insets top="12" right="18" bottom="12" left="18"/>
    </padding>

    <HBox alignment="CENTER" spacing="18" styleClass="brand-header">
        <StackPane styleClass="logo-halo" maxWidth="92" maxHeight="92">
            <ImageView fitWidth="80" fitHeight="80" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@company-logo-gold.png"/>
                </image>
            </ImageView>
        </StackPane>
        <VBox alignment="CENTER_LEFT" spacing="1">
            <Label text="OXMAN IT" styleClass="title"/>
            <Label text="GAME OPTIMIZER" styleClass="title2"/>
            <Label text="Competitive Performance Dashboard" styleClass="subtitle"/>
        </VBox>
    </HBox>

    <HBox alignment="CENTER" spacing="14">
        <VBox alignment="CENTER_LEFT" spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="CPU" styleClass="section"/>
            <ProgressBar fx:id="cpuBar" maxWidth="Infinity"/>
            <Label fx:id="cpuLabel" text="CPU: 0%"/>
            <Label fx:id="cpuNameLabel" text="Procesador" wrapText="true" styleClass="hardware-info"/>
            <Label fx:id="cpuCoresLabel" text="Núcleos" wrapText="true" styleClass="hardware-info"/>
            <Label fx:id="cpuFreqLabel" text="Frecuencia" wrapText="true" styleClass="hardware-info"/>
        </VBox>

        <VBox alignment="CENTER_LEFT" spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="RAM" styleClass="section"/>
            <ProgressBar fx:id="ramBar" maxWidth="Infinity"/>
            <Label fx:id="ramLabel" text="RAM: 0%"/>
            <Label text="GPU" styleClass="section-small"/>
            <Label fx:id="gpuLabel" text="Detectando GPU..." wrapText="true" styleClass="hardware-info"/>
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="system-card" maxWidth="Infinity">
        <Label text="DISCO" styleClass="section-small"/>
        <Label fx:id="diskLabel" text="Detectando disco..." wrapText="true"
               maxWidth="Infinity" styleClass="hardware-info" HBox.hgrow="ALWAYS"/>
        <Label text="WINDOWS" styleClass="section-small"/>
        <Label fx:id="osLabel" text="Detectando sistema..." wrapText="true"
               maxWidth="Infinity" styleClass="hardware-info" HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" text="🟢 Sistema óptimo" styleClass="status"/>
    </HBox>

    <VBox spacing="7" styleClass="system-card performance-lab" maxWidth="Infinity">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="PERFORMANCE LAB" styleClass="section"/>
            <Label text="Estado:" styleClass="control-label"/>
            <Label fx:id="performanceLabStateLabel" text="IDLE" styleClass="lab-state"/>
            <Label fx:id="performanceLabResultLabel"
                   text="Baseline de 10 segundos · 20 muestras · no estima FPS" wrapText="true" HBox.hgrow="ALWAYS"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="measureButton" text="MEDIR SISTEMA" onAction="#measureSystemBaseline"/>
        </HBox>
        <HBox alignment="BOTTOM_LEFT" spacing="12" maxWidth="Infinity">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="Modo" styleClass="control-label"/>
                <ComboBox fx:id="benchmarkMode" prefWidth="420" minWidth="280" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="3">
                <Label text="Runs" styleClass="control-label"/>
                <ComboBox fx:id="benchmarkRuns" prefWidth="90" minWidth="82"/>
            </VBox>
            <VBox spacing="3">
                <Label text="Duración" styleClass="control-label"/>
                <ComboBox fx:id="benchmarkDuration" prefWidth="110" minWidth="100"/>
            </VBox>
            <Button fx:id="benchmarkButton" text="INICIAR TEST" minWidth="150" onAction="#startBenchmark"/>
            <Button fx:id="cancelBenchmarkButton" text="CANCELAR" minWidth="120" disable="true" onAction="#cancelBenchmark"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="diagnostic-box">
            <Label text="DIAGNÓSTICO" styleClass="control-label"/>
            <Label text="·" styleClass="diagnostic-separator"/>
            <Label fx:id="presentMonStatusLabel" text="PresentMon: comprobando..." styleClass="hardware-info"/>
        </HBox>
    </VBox>

    <HBox alignment="CENTER" spacing="10">
        <ComboBox fx:id="gameSelector" prefWidth="250" minWidth="210" promptText="Detectando juegos..." HBox.hgrow="ALWAYS"/>
        <Button fx:id="boostButton" text="🚀 BOOST FPS" minWidth="150" prefWidth="190" prefHeight="44"
                onAction="#boostFPS"/>
        <Button fx:id="finishButton" text="FINALIZAR JUEGO" minWidth="175" prefWidth="190" prefHeight="44"
                disable="true" onAction="#finishGame"/>
    </HBox>

    <Label text="REGISTRO DE OPTIMIZACIÓN" styleClass="section"/>

    <TextArea fx:id="logArea"
              maxWidth="Infinity"
              prefHeight="280"
              minHeight="240"
              editable="false"
              wrapText="true"
              styleClass="log-area"
              VBox.vgrow="ALWAYS"/>

  </VBox>
  </content>
</ScrollPane>
